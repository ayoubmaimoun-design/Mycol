<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<title>موقع الألعاب</title>

<style>
body {
  margin: 0;
  font-family: Arial;
  background: #0f172a;
  color: white;
  text-align: center;
}

nav {
  background: #111827;
  padding: 15px;
}

.menu button {
  padding: 10px 20px;
  margin: 10px;
  cursor: pointer;
  background: #1f2937;
  color: white;
  border: none;
  border-radius: 8px;
}

.game {
  display: none;
  margin-top: 20px;
}

/* لعبة النقر */
.box {
  width: 150px;
  height: 150px;
  background: red;
  margin: 20px auto;
  cursor: pointer;
}
</style>
</head>

<body>

<nav>🎮 موقع الألعاب</nav>

<div class="menu">
  <button onclick="showGame('click')">لعبة النقر</button>
  <button onclick="showGame('guess')">تخمين رقم</button>
</div>

<!-- لعبة النقر -->
<div id="click" class="game">
  <h2>🔥 اضغط على المربع</h2>
  <div class="box" onclick="score()"></div>
  <h3 id="points">النقاط: 0</h3>
</div>

<!-- لعبة التخمين -->
<div id="guess" class="game">
  <h2>🎲 تخمين رقم من 1 إلى 5</h2>
  <input id="num" type="number" min="1" max="5">
  <button onclick="check()">تأكيد</button>
  <p id="result"></p>
</div>

<script>

let points = 0;

// إظهار لعبة
function showGame(id){
  document.querySelectorAll('.game').forEach(g => g.style.display = "none");
  document.getElementById(id).style.display = "block";
}

// لعبة النقر
function score(){
  points++;
  document.getElementById("points").innerText = "النقاط: " + points;
}

// لعبة التخمين
function check(){
  let user = document.getElementById("num").value;
  let random = Math.floor(Math.random() * 5) + 1;

  if(user == random){
    document.getElementById("result").innerText = "🎉 صحيح!";
  } else {
    document.getElementById("result").innerText = "❌ خطأ، الرقم كان " + random;
  }
}

</script>

</body>
</html>
